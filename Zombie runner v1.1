}
function closeInventory(){
  G.invOpen = false;
  if (!G.over) G.paused = false;
  const inv = $('invMenu');
  inv.style.opacity = '0';
  setTimeout(()=>{ if (!G.invOpen) inv.style.display = 'none'; }, 220);
  if (!G.over) renderer.domElement.requestPointerLock();
}
function toggleInventory(){
  if (G.invOpen) closeInventory();
  else openInventory();
}
function buildInventoryGrid(){
  const grid = $('invGrid');
  const equippedW = WEAPONS.find(w=>w.id===G.weapon);
  $('invCash').textContent = G.cash;
  $('invEquipped').textContent = 'EQUIPPED: ' + (equippedW?equippedW.name.toUpperCase():'NONE');
  grid.innerHTML = '';

  // Weapons section
  const weaponsSection = document.createElement('div');
  weaponsSection.style.gridColumn = '1 / -1';
  weaponsSection.innerHTML = '<div style="color:#ffb347; letter-spacing:2px; font-size:13px; margin-bottom:8px; border-bottom:1px solid rgba(255,150,40,.2); padding-bottom:4px;">WEAPONS</div>';
  grid.appendChild(weaponsSection);

  WEAPONS.forEach(w=>{
    const item = document.createElement('div');
    item.className = 'invItem' + (w.owned?' owned':'') + (w.id===G.weapon?' equipped':'');
    const rpm = w.rpm || Math.round(60 / (w.fireRate||0.13));
    const dmg = w.dmg + (w.pellets?'×'+w.pellets:'');
    if (!w.owned) {
      item.innerHTML = `
        <div class="invItemName">${w.name}</div>
        <div class="invItemDesc">${w.desc}</div>
        <div class="invItemStats">DMG ${dmg} | RPM ${rpm} | MAG ${w.mag} | RNG ${w.range}m</div>
        <div class="invItemPrice">${w.cost} CASH</div>
        <button class="invBtn" data-buy-weapon="${w.id}" ${G.cash < w.cost ? 'disabled':''}>BUY</button>
      `;
    } else {
      item.innerHTML = `
        <div class="invItemName">${w.name}</div>
        <div class="invItemDesc">${w.desc}</div>
        <div class="invItemStats">DMG ${dmg} | RPM ${rpm} | MAG ${w.mag} | RNG ${w.range}m</div>
        ${w.id===G.weapon
          ? `<button class="invBtn" disabled>EQUIPPED</button>`
          : `<button class="invBtn alt" data-equip="${w.id}">EQUIP</button>`
        }
      `;
    }
    grid.appendChild(item);
  });

  // Defense section — Armor + Shield side by side
  const defenseSection = document.createElement('div');
  defenseSection.style.gridColumn = '1 / -1';
  defenseSection.innerHTML = '<div style="color:#ffb347; letter-spacing:2px; font-size:13px; margin:16px 0 8px; border-bottom:1px solid rgba(255,150,40,.2); padding-bottom:4px;">DEFENSE</div>';
  grid.appendChild(defenseSection);

  const defenseGrid = document.createElement('div');
  defenseGrid.className = 'defenseGrid';
  grid.appendChild(defenseGrid);

  // Armor item
  const armorItem = document.createElement('div');
  armorItem.className = 'invItem' + (G.armor>0?' owned':'');
  const armorCd = Math.ceil(G.armorCd);
  armorItem.innerHTML = `
    <div class="invItemName" style="color:#ffc800;">BODY ARMOR</div>
    <div class="invItemStats">CURRENT: ${G.armor}/10</div>
    ${G.armor < 10
      ? `<div class="invItemPrice">300 CASH</div>
         <button class="invBtn" data-buy-item="armor" ${G.cash < 300 || G.armorCd > 0 ? 'disabled':''}>
           ${G.armorCd > 0 ? 'COOLDOWN ' + armorCd + 's' : 'BUY ARMOR'}
         </button>`
      : `<div class="invItemPrice" style="color:#8fff8f;">MAXED</div>`}
  `;
  defenseGrid.appendChild(armorItem);

  // Shield item
  const shieldItem = document.createElement('div');
  shieldItem.className = 'invItem' + (G.shield?' owned':'');
  const shieldMaxHp = Math.floor(G.maxHp * 0.2);
  const shieldPct = G.shield ? Math.floor(G.shieldHp / shieldMaxHp * 100) : 0;
  const shieldCd = Math.ceil(G.shieldCd);
  shieldItem.innerHTML = `
    <div class="invItemName" style="color:#00b4ff;">ENERGY SHIELD</div>
    <div class="invItemStats">${G.shield ? 'ACTIVE — ' + shieldPct + '%' : 'INACTIVE'}</div>
    ${!G.shield
      ? `<div class="invItemPrice">500 CASH</div>
         <button class="invBtn" data-buy-item="shield" ${G.cash < 500 || G.shieldCd > 0 ? 'disabled':''}>
           ${G.shieldCd > 0 ? 'COOLDOWN ' + shieldCd + 's' : 'BUY SHIELD'}
         </button>`
      : `<div class="invItemPrice" style="color:#8fff8f;">ACTIVE</div>`}
  `;
  defenseGrid.appendChild(shieldItem);

  // attach handlers — route weapons to buyWeapon, armor/shield to buyItem
  grid.querySelectorAll('button[data-buy-weapon]').forEach(b=>{
    b.onclick = () => {
      if (b.disabled) return;
      b.disabled = true;
      const originalText = b.textContent;
      b.textContent = 'BUYING...';
      buyWeapon(b.dataset.buyWeapon);
      setTimeout(() => { if (!b.disabled) { b.disabled = false; b.textContent = originalText; } }, 300);
    };
  });
  grid.querySelectorAll('button[data-buy-item]').forEach(b=>{
    b.onclick = () => {
      if (b.disabled) return;
      b.disabled = true;
      const originalText = b.textContent;
      b.textContent = 'BUYING...';
      buyItem(b.dataset.buyItem);
      setTimeout(() => { if (!b.disabled) { b.disabled = false; b.textContent = originalText; } }, 300);
    };
  });
  grid.querySelectorAll('button[data-equip]').forEach(b=>b.onclick=()=>equipWeapon(b.dataset.equip));
}
function buyWeapon(id){
  const w = WEAPONS.find(x=>x.id===id);
  if (!w || w.owned || G.cash < w.cost) return;
  G.cash -= w.cost; w.owned = true;
  equipWeapon(id); // auto-equip on purchase
  showToast(w.name + ' PURCHASED — AUTO-EQUIPPED');
  buildInventoryGrid();
  updateHUD();
}
function buyItem(id){
  if (id === 'armor'){
    if (G.armor >= 10 || G.cash < 300 || G.armorCd > 0) {
      showToast('CANNOT BUY ARMOR', 'error');
      return;
    }
    G.cash -= 300; G.armor++;
    G.armorCd = 30; // 30s gameplay cooldown
    // increase max HP by 10%
    const oldMax = G.maxHp;
    G.maxHp = 100 + G.armor * 10;
    G.hp = Math.min(G.maxHp, G.hp + (G.maxHp - oldMax)); // heal proportional
    showToast('BODY ARMOR PURCHASED — MAX HP INCREASED');
  }
  else if (id === 'shield'){
    if (G.shield || G.cash < 500 || G.shieldCd > 0) {
      showToast('CANNOT BUY SHIELD', 'error');
      return;
    }
    G.cash -= 500; G.shield = 1; G.shieldHp = Math.floor(G.maxHp * 0.2);
    // apply shield glow
    player.group.traverse(o=>{
      if (o.isMesh && o.material && !o.userData.isGun){
        o.material.emissive.setHex(0x0066ff);
        o.material.emissiveIntensity = 0.35;
      }
    });
    showToast('ENERGY SHIELD ACTIVATED');
  }
  buildInventoryGrid();
  updateHUD();
}
function unequipWeapon(id){
  const w = WEAPONS.find(x=>x.id===id);
  if (!w || !w.owned || w.id !== G.weapon) return;
  // switch to rifle if possible, else first owned weapon
  const fallback = WEAPONS.find(x=>x.owned && x.id!==id) || WEAPONS[0];
  equipWeapon(fallback.id); // use equipWeapon to handle visuals
  buildInventoryGrid();
  updateHUD();
}
function equipWeapon(id){
  const w = WEAPONS.find(x=>x.id===id);
  if (!w || !w.owned) return;

  // Remove previous weapon visuals
  if (player.parts.currentWeapon) {
    player.parts.rArm.remove(player.parts.currentWeapon);
    player.parts.currentWeapon = null;
  }
  if (player.parts.currentWeaponL) {
    player.parts.lArm.remove(player.parts.currentWeaponL);
    player.parts.currentWeaponL = null;
    player.parts.currentWeaponR = null;
  }

  // Create new weapon model(s)
  const model = createWeaponModel(id);
  if (!model) return;

  if (model.isDual) {
    // Dual UZI — attach one to each arm
    player.parts.lArm.add(model.left);
    player.parts.rArm.add(model.right);
    player.parts.currentWeaponL = model.left;
    player.parts.currentWeaponR = model.right;
    player.parts.muzzle = model.muzzleR; // primary muzzle for effects
    player.parts.muzzleL = model.muzzleL;
  } else {
    // Single weapon — attach to right arm
    player.parts.rArm.add(model.group);
    player.parts.currentWeapon = model.group;
    player.parts.muzzle = model.muzzle;
    player.parts.muzzleL = null;
  }

  // Gameplay state
  G.weapon = id;
  G.mag = w.mag; G.ammo = w.mag; G.reloading = 0; G.fireCd = 0;

  buildInventoryGrid();
  updateHUD();
}
function updateHUD(){
  hud.cash.textContent = G.cash;
  hud.ammo.innerHTML = G.ammo + ' <small>/ ' + G.mag + '</small>';
  // armor UI
  const armorPct = G.armor * 10;
  $('armorBar').style.width = armorPct + '%';
  $('armorBar').style.opacity = G.armor > 0 ? '1' : '0';
  $('armorCount').textContent = 'x' + G.armor;
  $('armorIcon').style.opacity = G.armor > 0 ? '1' : '0';
  $('armorCooldown').textContent = G.armorCd > 0 ? ' (' + Math.ceil(G.armorCd) + 's)' : '';
  // shield UI
  const shieldPct = G.shield ? Math.floor(G.shieldHp / (G.maxHp * 0.2) * 100) : 0;
  $('shieldBar').style.width = shieldPct + '%';
  $('shieldBar').style.opacity = G.shield ? '1' : '0';
  $('shieldIcon').style.opacity = G.shield ? '1' : '0';
  $('shieldPct').textContent = G.shield ? shieldPct + '%' : 'INACTIVE';
  $('shieldCooldown').textContent = G.shieldCd > 0 ? ' (' + Math.ceil(G.shieldCd) + 's)' : '';
  // player glow effect for shield
  if (G.shield && player.group){
    player.group.traverse(o=>{
      if (o.isMesh && o.material && !o.userData.isGun){
        o.material.emissive.setHex(0x0066ff);
        o.material.emissiveIntensity = 0.35;
      }
    });
  }
}

