let invAnimId = null;
function openInventory(){
  if (G.over) return;
  G.invOpen = true; G.paused = true;
  buildInventoryGrid();
  const inv = $('invMenu');
  inv.style.display = 'flex';
  // force reflow for transition
  void inv.offsetWidth;
  inv.style.opacity = '1';
