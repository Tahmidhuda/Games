/* ============================================================
   CHARACTER FACTORY — procedural 3D models built from the
   reference sheets (soldier, undead, wolf, colossi)
   ============================================================ */
function M(color, opt={}) {
  return new THREE.MeshStandardMaterial(Object.assign({ color, roughness:0.9, metalness:0.05 }, opt));
}
function box(w,h,d,mat,x=0,y=0,z=0,shadow=true){
  const m = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), mat);
  m.position.set(x,y,z); m.castShadow = shadow; m.receiveShadow = true;
  return m;
}
function sph(r,mat,x=0,y=0,z=0,ws=10,hs=8){
  const m = new THREE.Mesh(new THREE.SphereGeometry(r,ws,hs), mat);
  m.position.set(x,y,z); m.castShadow = true;
  return m;
}
function cone(r,h,mat,x=0,y=0,z=0){
  const m = new THREE.Mesh(new THREE.ConeGeometry(r,h,7), mat);
  m.position.set(x,y,z); m.castShadow = true;
  return m;
}

// ---------- SOLDIER (player) — tan/olive spec-ops from reference ----------
function buildSoldier(){
  const g = new THREE.Group();
  const skin = M(0xb98a62), olive = M(0x4c4a33), dark = M(0x2e2c22), vest = M(0x3f4230);
  const parts = {};

  parts.body = box(0.62,0.72,0.36, olive, 0,1.32,0); g.add(parts.body);
  const v = box(0.66,0.5,0.42, vest, 0,1.36,0); g.add(v);                    // plate carrier
  for (let i=0;i<3;i++) g.add(box(0.14,0.16,0.06, dark, -0.18+i*0.18, 1.28, 0.24)); // mag pouches
  g.add(box(0.5,0.24,0.3, dark, 0,0.94,0));                                   // belt/hip
  g.add(box(0.08,0.14,0.14, M(0x1c1d20), -0.28,0.96,0.14));                   // sidearm holster
  g.add(box(0.16,0.06,0.05, M(0x14161a), 0.28,1.02,0.2));                      // tactical blade sheath

  parts.head = new THREE.Group(); parts.head.position.set(0,1.86,0);
  parts.head.add(sph(0.17, skin, 0,0,0));
  const helmet = sph(0.2, M(0x3a3d2c), 0,0.05,0); helmet.scale.set(1,0.82,1.05); parts.head.add(helmet);
  parts.head.add(box(0.3,0.07,0.05, M(0x14161a), 0,0.02,0.17));               // goggles
  parts.head.add(box(0.22,0.03,0.03, dark, 0,-0.06,0.18));                     // jaw strap
  parts.head.add(box(0.16,0.05,0.04, M(0x1a1d22), 0,0.12,0.16));               // NVG mount
  g.add(parts.head);

  // arms — grouped at shoulder so they can aim
  function arm(side){
    const a = new THREE.Group(); a.position.set(side*0.4, 1.6, 0);
    const upper = box(0.16,0.34,0.16, olive, 0,-0.16,0); a.add(upper);
    const fore = box(0.14,0.32,0.14, skin, 0,-0.46,0.02); a.add(fore);
    a.add(box(0.15,0.12,0.15, dark, 0,-0.66,0.02));                            // glove
    return a;
  }
  parts.lArm = arm(-1); parts.rArm = arm(1);
  g.add(parts.lArm, parts.rArm);

  // weapon slot — the current weapon model is attached here by equipWeapon()
  // (both arms stay as plain limbs; weapons get added/removed on equip)

  // legs
  function leg(side){
    const l = new THREE.Group(); l.position.set(side*0.17, 0.92, 0);
    l.add(box(0.2,0.44,0.2, M(0x555238), 0,-0.22,0));
    l.add(box(0.18,0.4,0.18, M(0x494631), 0,-0.62,0));
    l.add(box(0.2,0.14,0.3, M(0x26241c), 0,-0.86,0.05));                       // boot
    return l;
  }
  parts.lLeg = leg(-1); parts.rLeg = leg(1);
  g.add(parts.lLeg, parts.rLeg);

  g.add(box(0.5,0.55,0.2, M(0x3a3d2c), 0,1.4,-0.3));                           // backpack
  g.add(box(0.2,0.12,0.1, M(0x454a33), 0.08,1.62,-0.32));                      // pack top pouch
  g.add(box(0.32,0.05,0.06, M(0x1c1d20), 0,1.52,-0.38));                       // rolled strap
  g.add(cone(0.06,0.22, M(0x14161a), -0.3,0.9,-0.02));                         // knife on belt
  g.add(box(0.4,0.08,0.05, dark, 0,0.9,0.2));                                  // belt buckle
  return { group:g, parts };
}

// ---------- generic undead humanoid ----------
function buildZombie(cfg){
  const g = new THREE.Group();
  const skin = M(cfg.skin), shirt = M(cfg.shirt), pants = M(cfg.pants);
  const parts = {};
  const hunch = cfg.hunch || 0;

  parts.body = box(0.6,0.7,0.34, shirt, 0,1.3,0);
  parts.body.rotation.x = hunch; g.add(parts.body);
  // torn funnel shirt: slanted slits + exposed belly
  for (let i=0;i<3;i++){
    const tear = box(0.1, rnd(0.16,0.3), 0.05, skin, rnd(-0.2,0.2), 1.12+rnd(0,0.12), 0.2);
    tear.rotation.z = rnd(-0.5,0.5); g.add(tear);
  }
  g.add(sph(0.16, skin, 0,0.98,0.22));                                       // exposed chest wound
  if (cfg.hood){
    const hood = sph(0.2, shirt, 0,1.86,-0.06); hood.scale.set(1,1.05,1); g.add(hood);
    parts.headHood = hood;
  }
  parts.head = new THREE.Group(); parts.head.position.set(0,1.84,0.06+hunch*0.3);
  parts.head.add(sph(0.17, skin, 0,0,0));
  // glowing dead eyes
  const eyeM = M(0x000000,{ emissive:cfg.eye||0xd8e6c8, emissiveIntensity:1.6 });
  parts.head.add(sph(0.028, eyeM, -0.06,0.02,0.15,6,5));
  parts.head.add(sph(0.028, eyeM,  0.06,0.02,0.15,6,5));
  parts.head.add(box(0.12,0.05,0.04, M(0x2a1414), 0,-0.08,0.15));              // jaw
  parts.head.add(box(0.1,0.03,0.03, skin, 0,-0.05,0.17));                      // exposed teeth band
  if (cfg.hair) { const hr = sph(0.18, M(cfg.hair), 0,0.05,-0.03); hr.scale.set(1,0.8,1); parts.head.add(hr); }
  g.add(parts.head);

  // wounds — torn flesh with darker dried-blood centers
  const woundM = M(0x5e1414,{roughness:1}), scabM = M(0x3a0e0e,{roughness:1});
  for (let i=0;i<(cfg.wounds??3);i++){
    const w = sph(rnd(0.05,0.09), woundM, rnd(-0.25,0.25), rnd(1.0,1.6), 0.19, 6,5);
    w.scale.z = 0.4; g.add(w);
    if (i%2===0){                                                       // darker scab center
      const c = sph(rnd(0.025,0.04), scabM, w.position.x, w.position.y-0.01, 0.24, 6,5);
      c.scale.z = 0.4; g.add(c);
    }
  }

  function arm(side){
    const a = new THREE.Group(); a.position.set(side*0.38, 1.58, 0);
    a.add(box(0.15,0.34,0.15, shirt, 0,-0.16,0));
    a.add(box(0.13,0.34,0.13, skin, 0,-0.48,0));
    a.rotation.x = -1.15 - hunch;                                               // reaching forward
    a.rotation.z = side*0.12;
    return a;
  }
  parts.lArm = arm(-1); parts.rArm = arm(1);
  g.add(parts.lArm, parts.rArm);

  function leg(side){
    const l = new THREE.Group(); l.position.set(side*0.16, 0.94, 0);
    l.add(box(0.19,0.46,0.19, pants, 0,-0.23,0));
    l.add(box(0.17,0.42,0.17, pants, 0,-0.64,0));
    l.add(box(0.19,0.12,0.28, M(0x2c2620), 0,-0.88,0.04));
    return l;
  }
  parts.lLeg = leg(-1); parts.rLeg = leg(1);
  g.add(parts.lLeg, parts.rLeg);

  g.scale.setScalar(cfg.scale||1);
  return { group:g, parts };
}

// ---------- CORRUPTED WOLF (quadruped, dorsal spines) ----------
function buildWolf(){
  const g = new THREE.Group();
  const fur = M(0x4a4a4d,{roughness:1}), flesh = M(0x6e3a3a,{roughness:1}), bone = M(0xcfc4a8);
  const parts = {};
  parts.body = box(0.5,0.5,1.3, fur, 0,0.78,0); g.add(parts.body);
  // exposed flesh patches
  const p1 = sph(0.16, flesh, 0.2,0.9,-0.2); p1.scale.set(1,0.7,1.4); g.add(p1);
  const p2 = sph(0.14, flesh, -0.18,0.86,0.3); p2.scale.set(1,0.7,1.3); g.add(p2);
  // rib-cage bone shards jutting out of the flesh wounds
  for (let i=0;i<4;i++){
    const rib = cone(0.02, rnd(0.1,0.16), bone, -0.24+rnd(0,0.1), 0.82+rnd(0,0.08), -0.3+rnd(0,0.1));
    rib.rotation.x = Math.PI+ rnd(0,0.4); g.add(rib);
  }
  // dorsal spines — taller, curving back
  for (let i=0;i<6;i++){
    const s = cone(0.07, rnd(0.28,0.42), bone, -0.1+rnd(-0.06,0.06), 1.16, -0.5+i*0.2);
    s.rotation.x = -0.75 + i*0.06; g.add(s);
  }
  // neck ridge + scapula spikes
  parts.head = new THREE.Group(); parts.head.position.set(0,0.92,0.78);
  parts.head.add(box(0.3,0.3,0.36, fur, 0,0,0));
  parts.head.add(box(0.16,0.16,0.3, fur, 0,-0.04,0.3));                        // snout
  parts.head.add(box(0.3,0.08,0.34, M(0x3d3d40), 0,0.18,0.02));                // mane
  const eyeM = M(0x000000,{emissive:0xffa020, emissiveIntensity:2.2});
  parts.head.add(sph(0.035, eyeM, -0.1,0.07,0.17,6,5));
  parts.head.add(sph(0.035, eyeM,  0.1,0.07,0.17,6,5));
  const e1 = cone(0.06,0.16, fur, -0.1,0.26,-0.02), e2 = cone(0.06,0.16, fur, 0.1,0.26,-0.02);
  parts.head.add(e1,e2);
  // fangs — 4, angled down
  parts.head.add(cone(0.02,0.09, bone, -0.08,-0.1,0.42));
  parts.head.add(cone(0.02,0.09, bone, -0.03,-0.1,0.44));
  parts.head.add(cone(0.02,0.09, bone,  0.03,-0.1,0.44));
  parts.head.add(cone(0.02,0.09, bone,  0.08,-0.1,0.42));
  parts.head.children.slice(-4).forEach(f=>{ f.rotation.x = Math.PI; f.position.y += 0.05; });
  g.add(parts.head);
  parts.tail = box(0.1,0.1,0.5, fur, 0,0.85,-0.85); g.add(parts.tail);
  // tail bone-tip
  parts.tail.add(cone(0.04,0.14, bone, 0,0,-0.3));

  parts.legs = [];
  [[-0.2,0.45],[0.2,0.45],[-0.2,-0.45],[0.2,-0.45]].forEach((p,i)=>{
    const l = new THREE.Group(); l.position.set(p[0], 0.62, p[1]);
    l.add(box(0.12,0.5,0.12, fur, 0,-0.25,0));
    l.add(box(0.1,0.24,0.14, M(0x3a3a3d), 0,-0.56,0.02));
    // wicked front claws on forelegs
    if (i<2) for (let c=0;c<2;c++){
      const cl = cone(0.02,0.12, bone, -0.03+c*0.06, -0.68, 0.09); cl.rotation.x = Math.PI/2; l.add(cl);
    }
    g.add(l); parts.legs.push(l);
  });
  return { group:g, parts };
}

