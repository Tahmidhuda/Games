             hp:190, speed:2.1, dmg:18, range:2.3, score:250, radius:1.2 },
  stalker: { build:()=>buildZombie({skin:0x9aa08a, shirt:0x6a6a62, pants:0x50554e, hunch:0.45, hair:0x3a2e24, wounds:4, eye:0xc8e6ff}),
             hp:45,  speed:5.4, dmg:7,  range:1.7, score:150, radius:0.8 },
  wolf:    { build:buildWolf, hp:40, speed:6.6, dmg:8, range:1.8, score:150, radius:0.9, quad:true },
};
const BOSSES = [
  { name:'STITCHED JUGGERNAUT', build:buildJuggernaut, hp:900,  speed:2.4, dmg:26, range:3.4, score:2000, radius:2.2 },
  { name:'TWIN-HEAD ABOMINATION', build:buildAbomination, hp:1150, speed:2.7, dmg:30, range:3.6, score:3000, radius:2.4 },
  { name:'BLOATED BEHEMOTH', build:buildBehemoth, hp:1400, speed:3.0, dmg:34, range:4.0, score:4000, radius:2.8, quad:true },
];

function spawnEnemy(type, isBoss=false){
  const cfg = isBoss ? type : ZTYPES[type];
  const model = cfg.build();
  const e = {
    cfg, isBoss, ...model,
    hp: cfg.hp * (isBoss ? (1 + (G.level-1)*0.35) : (1 + (G.level-1)*0.18)),
    maxHp: 0, attackCd:0, phase:Math.random()*6, flash:0, slamCd:4, slamming:0,
  };
  e.maxHp = e.hp;
  // spawn at road edges / far ends around player
  const ahead = Math.random()<0.7 ? -1 : 1;
  const z = player.group.position.z + ahead*rnd(50,90);
  e.group.position.set(rnd(-ROAD_HALF+1.5, ROAD_HALF-1.5), 0, Math.max(-ROAD_LEN/2+8, Math.min(ROAD_LEN/2-8, z)));
  e.group.userData.enemy = e;
  // collect only non-glowing materials for hit-flash (eyes/pustules keep their emissive)
  e.flashMats = [];
  e.group.traverse(o=>{
    if (o.isMesh && o.material && o.material.emissive && o.material.emissive.getHex()===0 && !e.flashMats.includes(o.material))
      e.flashMats.push(o.material);
  });
  // faint self-glow so the models stay readable against the dusk backlight
  for (const m of e.flashMats){
    m.emissive.copy(m.color).multiplyScalar(0.17);
    m.userData.baseEmissive = m.emissive.getHex();
  }
  scene.add(e.group);
  G.enemies.push(e);
  if (isBoss){
    G.boss = e;
    hud.bossName.textContent = cfg.name;
    hud.bossWrap.style.display = 'block';
    showBanner('⚠ ' + cfg.name + ' ⚠', 'LEVEL ' + G.level + ' — FINAL WAVE', 3000);
    G.shake = Math.max(G.shake, 0.6);
  }
  return e;
}

function killEnemy(e){
  burst(e.group.position.clone().setY(e.isBoss?2.5:1.3), 0x6e1414, e.isBoss?60:18, e.isBoss?8:4, 0.9, e.isBoss?0.6:0.32);
  if (e.isBoss){
    burst(e.group.position.clone().setY(2), 0xff8a3a, 50, 10, 1.2, 0.8);
    G.shake = 1.2;
    hud.bossWrap.style.display = 'none';
    G.boss = null;
    G.levelClear = 3.5;
    showBanner('LEVEL ' + G.level + ' CLEARED', '+30 INTEGRITY — NEXT LEVEL INCOMING', 3000);
    G.hp = Math.min(G.maxHp, G.hp+30);
  }
  // cash reward
  const cashGain = Math.floor(e.cfg.score * 0.25);
  G.cash += cashGain;
  updateHUD();
  // enemy ragdoll
  ragdollPool.push(createRagdoll(e, false));
  G.score += e.cfg.score; G.kills++;
  scene.remove(e.group);
  G.enemies.splice(G.enemies.indexOf(e),1);
}

/* ============================================================
   WAVE / LEVEL DIRECTOR
   ============================================================ */
function waveComp(){
  const l = G.level, w = G.wave;
  const n = 3 + l + w;
  const pool = ['walker'];
  if (l>=1 && w>=2) pool.push('stalker');
  if (l>=1 && w>=3) pool.push('wolf');
  if (l>=2 || w>=4) pool.push('brute');
  const list = [];
  for (let i=0;i<n;i++) list.push(pool[(Math.random()*pool.length)|0]);
  return list;
}
let pendingSpawns = [];
function startWave(){
  if (G.wave === G.WAVES_PER_LEVEL){
    // level-end boss wave: boss + escorts
    const bossCfg = BOSSES[(G.level-1) % BOSSES.length];
    spawnEnemy(bossCfg, true);
    pendingSpawns = waveComp().slice(0, 3 + G.level);
  } else {
    pendingSpawns = waveComp();
    showBanner('WAVE ' + G.wave, G.wave===1 ? 'LEVEL ' + G.level + ' — HOLD THE MILE' : '', 1600);
  }
  G.spawnTimer = 0;
}

/* ============================================================
   COMBAT
   ============================================================ */
const raycaster = new THREE.Raycaster();
function startReload(){
  if (G.reloading>0 || G.ammo===G.mag || !G.running) return;
  G.reloading = 1.4;
  hud.reload.textContent = 'RELOADING…';
}
function shoot(){
  const w = WEAPONS.find(x=>x.id===G.weapon);
  if (!w) return;
  G.fireCd = 60 / w.rpm;
  G.ammo -= w.dual ? 2 : 1;
  G.shake = Math.max(G.shake, w.id==='shotgun' ? 0.22 : (w.id==='uzi' ? 0.05 : 0.08));

  // muzzle flash(es)
  if (w.dual){
    // Dual UZI — fire from both weapon muzzles (falls back to hand positions)
    const mpL = player.parts.muzzleL ? player.parts.muzzleL.getWorldPosition(new THREE.Vector3())
                                     : player.parts.lArm.getWorldPosition(new THREE.Vector3());
    const mpR = player.parts.muzzle   ? player.parts.muzzle.getWorldPosition(new THREE.Vector3())
                                     : player.parts.rArm.getWorldPosition(new THREE.Vector3());
    if (!player.parts.muzzleL){
      const fwd = new THREE.Vector3();
      fwd.set(-Math.sin(G.yaw), 0, -Math.cos(G.yaw));
      mpL.addScaledVector(fwd, 0.4); mpL.y += 0.1;
      mpR.addScaledVector(fwd, 0.4); mpR.y += 0.1;
    }

    muzzleLight.position.copy(mpR); muzzleLight.intensity = 24;
    muzzleSprite.position.copy(mpR); muzzleSprite.material.opacity = 0.9;
    muzzleBurst(mpL, w); muzzleBurst(mpR, w);

    // fire from both
    const pellets = w.pellets || 1;
    const spread = w.spread || 0;
    for (let side=0; side<2; side++){
      const mp = side===0 ? mpL : mpR;
      for (let p=0; p<pellets; p++){
        const offsetX = spread ? rnd(-spread, spread) : 0;
        const offsetY = spread ? rnd(-spread, spread) : 0;
        raycaster.setFromCamera({x:offsetX, y:offsetY}, camera);
        raycaster.far = w.range;
        const meshes = G.enemies.map(e=>e.group);
        const hits = raycaster.intersectObjects(meshes, true);
        let end = raycaster.ray.at(w.range, new THREE.Vector3());
        if (hits.length){
          let o = hits[0].object, e = null;
          while (o){ if (o.userData.enemy){ e = o.userData.enemy; break; } o = o.parent; }
          if (e){
            end = hits[0].point;
            const dmg = w.dmg * rnd(0.9,1.15);
            e.hp -= dmg; e.flash = 0.09;
            const kbDir = new THREE.Vector3().subVectors(e.group.position, player.group.position).setY(0).normalize();
            e.group.position.addScaledVector(kbDir, 0.25);
            hitBurst(end, w);
            if (e.hp<=0) killEnemy(e);
          }
        }
        tracer(mp, end);
      }
    }
  } else {
    // Single weapon
    const mp = player.parts.muzzle.getWorldPosition(new THREE.Vector3());
    muzzleLight.position.copy(mp); muzzleLight.intensity = w.id==='shotgun' ? 48 : 30;
    muzzleSprite.position.copy(mp); muzzleSprite.material.opacity = 0.95;
    muzzleBurst(mp, w);

    const pellets = w.pellets || 1;
    const spread = w.spread || 0;
    for (let p=0; p<pellets; p++){
      const offsetX = spread ? rnd(-spread, spread) : 0;
      const offsetY = spread ? rnd(-spread, spread) : 0;
      raycaster.setFromCamera({x:offsetX, y:offsetY}, camera);
      raycaster.far = w.range;
      const meshes = G.enemies.map(e=>e.group);
      const hits = raycaster.intersectObjects(meshes, true);
      let end = raycaster.ray.at(w.range, new THREE.Vector3());
      if (hits.length){
        let o = hits[0].object, e = null;
        while (o){ if (o.userData.enemy){ e = o.userData.enemy; break; } o = o.parent; }
        if (e){
          end = hits[0].point;
          const dmg = w.dmg * rnd(0.9,1.15);
          e.hp -= dmg; e.flash = 0.09;
          const kbDir = new THREE.Vector3().subVectors(e.group.position, player.group.position).setY(0).normalize();
          e.group.position.addScaledVector(kbDir, 0.35 + (w.id==='shotgun'?0.25:0));
          hitBurst(end, w);
          if (e.hp<=0) killEnemy(e);
        }
      }
      tracer(mp, end);
    }
  }
  if (G.ammo<=0) startReload();
}

function hurtPlayer(dmg){
  if (G.over) return;
  // shield absorbs first
  if (G.shield){
    G.shieldHp -= dmg;
    if (G.shieldHp <= 0){
      // shield broken
      G.shield = 0; G.shieldHp = 0; G.shieldCd = 30; // 30s gameplay cooldown
      // remove glow effect
      player.group.traverse(o=>{
        if (o.isMesh && o.material && !o.userData.isGun){
          o.material.emissive.setHex(0);
          o.material.emissiveIntensity = 0;
        }
      });
    }
    G.shake = Math.max(G.shake, 0.15);
    updateHUD();
    return;
  }
  // armor reduces damage (each armor = 5% damage reduction, max 50%)
  const armorReduction = Math.min(0.5, G.armor * 0.05);
  const finalDmg = Math.ceil(dmg * (1 - armorReduction));
  G.hp -= finalDmg; damageFlash(); G.shake = Math.max(G.shake, 0.25);
  if (G.hp<=0){
    G.hp = 0; G.over = true; G.running = false;
    document.exitPointerLock();
    // player ragdoll
    ragdollPool.push(createRagdoll(player, true));
    // hide live player model
    player.group.visible = false;
    $('finalStats').innerHTML =
      `LEVEL REACHED <span>${G.level}</span> &nbsp;•&nbsp; KILLS <span>${G.kills}</span> &nbsp;•&nbsp; SCORE <span>${G.score}</span>`;
    $('gameover').style.display = 'flex';
    $('hud').style.display = 'none';
  }
  updateHUD();
}

// boss slam telegraph ring
const slamRing = new THREE.Mesh(
  new THREE.RingGeometry(0.1, 1, 40),
  new THREE.MeshBasicMaterial({ color:0xff3a1a, transparent:true, opacity:0, side:THREE.DoubleSide, depthWrite:false })
);
slamRing.rotation.x = -Math.PI/2; scene.add(slamRing);

/* ============================================================
   MAIN LOOP
   ============================================================ */
const clock = new THREE.Clock();
const camTarget = new THREE.Vector3();
const fwd = new THREE.Vector3(), rgt = new THREE.Vector3();

function animate(){
  requestAnimationFrame(animate);
  const dt = Math.min(clock.getDelta(), 0.05);
  G.time += dt;

  // cooldowns tick during gameplay (cooldowns keep running while the Armory is
  // open so the shop countdowns stay live; paused/game-over still freezes them)
  if (G.running && !G.paused && !G.over){
    let cdTick = false;
    if (G.armorCd > 0){ const prev = Math.ceil(G.armorCd); G.armorCd = Math.max(0, G.armorCd - dt); if (Math.ceil(G.armorCd) !== prev) cdTick = true; }
    if (G.shieldCd > 0){ const prev = Math.ceil(G.shieldCd); G.shieldCd = Math.max(0, G.shieldCd - dt); if (Math.ceil(G.shieldCd) !== prev) cdTick = true; }
    // rebuild the Armory once per second while open so cooldowns count down visibly
    if (cdTick){
      if (G.invOpen) buildInventoryGrid();
      updateHUD();
    }
  }

  // ambient FX always run
  for (const s of smokeSprites){
    const u = s.userData; u.t += dt*u.speed*0.35;
    if (u.t>1) u.t = 0;
    const t = u.t;
    s.position.set(u.x + u.drift*t*6 + Math.sin(G.time*0.5+u.y)*0.5, u.y + t*14*u.scale*0.4, u.z);
    s.scale.setScalar(u.scale*(0.6+t*2.2));
    s.material.opacity = 0.34*Math.sin(t*Math.PI);
  }
  const ap = ash.geometry.attributes.position;
  for (let i=0;i<ASH;i++){
    let y = ap.getY(i) - dt*rnd(0.4,1.0);
    if (y<0) y = 30;
    ap.setY(i, y);
    ap.setX(i, ap.getX(i) + Math.sin(G.time*0.6+i)*dt*0.4);
  }
  ap.needsUpdate = true;
  ash.position.z = camera.position.z;
  fireLights.forEach((l,i)=>{ l.intensity = 16 + Math.sin(G.time*11+i*3)*5 + Math.sin(G.time*23+i)*3; });
  muzzleLight.intensity *= 0.6; muzzleSprite.material.opacity *= 0.6;

  // particles (pooled)
  for (let i=particlePool.length-1;i>=0;i--){
    const p = particlePool[i];
    if (!p.visible) continue;
    const u = p.userData;
    u.life -= dt;
    if (u.life<=0){ releaseParticle(p); continue; }
    u.vel.y -= 9*dt;
    p.position.addScaledVector(u.vel, dt);
    p.material.opacity = 0.95*(u.life/u.max);
  }
  // ragdolls
  updateRagdolls(dt);
  for (let i=tracers.length-1;i>=0;i--){
    const t = tracers[i]; t.userData.life -= dt;
    t.material.opacity = Math.max(0, t.userData.life/0.07);
    if (t.userData.life<=0){ scene.remove(t); tracers.splice(i,1); }
  }

  if (G.running && !G.paused){
    /* ---- player movement ---- */
    const sprint = keys['ShiftLeft']||keys['ShiftRight'] ? 1.55 : 1;
    fwd.set(-Math.sin(G.yaw), 0, -Math.cos(G.yaw));
    rgt.set(-fwd.z, 0, fwd.x);
    const mv = new THREE.Vector3();
    if (keys['KeyW']) mv.add(fwd);
    if (keys['KeyS']) mv.sub(fwd);
    if (keys['KeyD']) mv.add(rgt);
    if (keys['KeyA']) mv.sub(rgt);
    const moving = mv.lengthSq()>0;
    if (moving){
      mv.normalize().multiplyScalar(9.3*sprint*dt);
      player.group.position.add(mv);
      player.group.position.x = Math.max(-ROAD_HALF, Math.min(ROAD_HALF, player.group.position.x));
      player.group.position.z = Math.max(-ROAD_LEN/2+6, Math.min(ROAD_LEN/2-6, player.group.position.z));
      resolveCollisions(player.group, PLAYER_RADIUS);
      walkPhase += dt*9*sprint;
    } else walkPhase += dt*2;
    const sw = moving ? 0.55 : 0.05;
    player.parts.lLeg.rotation.x = Math.sin(walkPhase)*sw;
    player.parts.rLeg.rotation.x = -Math.sin(walkPhase)*sw;
    player.group.rotation.y = G.yaw + Math.PI;
    // smooth aim: lerp arms/gun to target pitch/yaw
    const targetArmX = -Math.PI/2 - G.pitch;
    const targetArmZ = 0.5;
    player.parts.rArm.rotation.x = THREE.MathUtils.lerp(player.parts.rArm.rotation.x, targetArmX, G.aimLerp);
    player.parts.rArm.rotation.z = THREE.MathUtils.lerp(player.parts.rArm.rotation.z, targetArmZ, G.aimLerp);
    player.parts.lArm.rotation.x = THREE.MathUtils.lerp(player.parts.lArm.rotation.x, targetArmX, G.aimLerp);
    player.parts.lArm.rotation.z = THREE.MathUtils.lerp(player.parts.lArm.rotation.z, targetArmZ, G.aimLerp);
    player.parts.head.rotation.x = THREE.MathUtils.lerp(player.parts.head.rotation.x, -G.pitch*0.5, G.aimLerp);

    /* ---- camera (3rd person, over-shoulder) ---- */
    const dist = 5.4, side = 1.0, height = 2.3;
    camTarget.copy(player.group.position).add(new THREE.Vector3(0,height,0));
    const off = new THREE.Vector3(Math.sin(G.yaw)*Math.cos(G.pitch), Math.sin(G.pitch), Math.cos(G.yaw)*Math.cos(G.pitch)).multiplyScalar(dist);
    off.add(rgt.clone().multiplyScalar(side));
    camera.position.copy(camTarget).add(off);
    if (G.shake>0){
      camera.position.x += rnd(-1,1)*G.shake*0.25;
      camera.position.y += rnd(-1,1)*G.shake*0.25;
      G.shake = Math.max(0, G.shake - dt*2.2);
    }
    camera.lookAt(camTarget.clone().add(fwd.clone().multiplyScalar(6)).add(new THREE.Vector3(0,-G.pitch*4,0)));
    duskSun.target.position.copy(player.group.position);
    duskSun.position.set(player.group.position.x+70, 46, player.group.position.z-95);
    heroLight.position.set(player.group.position.x, 3.4, player.group.position.z+1.5);

    /* ---- firing ---- */
    G.fireCd -= dt;
    if (G.reloading>0){
      G.reloading -= dt;
      if (G.reloading<=0){ G.ammo = G.mag; hud.reload.textContent=''; }
    } else if (firing && G.fireCd<=0 && G.ammo>0) shoot();

    /* ---- wave director ---- */
    if (G.levelClear>0){
      G.levelClear -= dt;
      if (G.levelClear<=0){
        G.level++; G.wave = 1;
        startWave();
      }
    } else if (pendingSpawns.length){
      G.spawnTimer -= dt;
      if (G.spawnTimer<=0 && G.enemies.length < 14){
        spawnEnemy(pendingSpawns.pop());
        G.spawnTimer = rnd(0.5, 1.4);
      }
    } else if (G.enemies.length===0 && !G.boss){
      G.interWave += dt;
      if (G.interWave > 2.2){
        G.interWave = 0;
        G.wave++;
        if (G.wave > G.WAVES_PER_LEVEL) G.wave = G.WAVES_PER_LEVEL; // safety
        startWave();
      }
    }

    /* ---- enemies AI ---- */
    const pp = player.group.position;
    for (const e of [...G.enemies]){
      const ep = e.group.position;
      const toP = new THREE.Vector3().subVectors(pp, ep); toP.y = 0;
      const d = toP.length();
      e.group.rotation.y = Math.atan2(toP.x, toP.z);
      e.phase += dt * e.cfg.speed * 2.2;
      const limp = e.cfg.quad ? 0.7 : 0.5;
      if (e.parts.legs){ // quadruped
        e.parts.legs.forEach((l,i)=> l.rotation.x = Math.sin(e.phase + (i%2?Math.PI:0) + (i>1?0.5:0))*limp);
      } else {
        e.parts.lLeg.rotation.x = Math.sin(e.phase)*limp;
        e.parts.rLeg.rotation.x = -Math.sin(e.phase)*limp;
        e.parts.lArm.rotation.x = -1.15 + Math.sin(e.phase)*0.18;
        e.parts.rArm.rotation.x = -1.15 - Math.sin(e.phase)*0.18;
      }
      if (e.parts.tail) e.parts.tail.rotation.y = Math.sin(G.time*6)*0.4;
      if (e.parts.pustules) e.parts.pustules.forEach((p,i)=> p.material.emissiveIntensity = 1.8+Math.sin(G.time*3+i)*0.9);
      if (e.parts.heads) e.parts.heads.forEach((h,i)=> h.rotation.z = Math.sin(G.time*1.4+i*2)*0.14);

      if (d > e.cfg.range){
        toP.normalize();
        ep.addScaledVector(toP, e.cfg.speed*dt);
        ep.x = Math.max(-ROAD_HALF-2, Math.min(ROAD_HALF+2, ep.x));
        resolveCollisions(e.group, e.cfg.radius);
      } else {
        e.attackCd -= dt;
        if (e.attackCd<=0){
          e.attackCd = e.isBoss?1.4:1.0;
          hurtPlayer(e.cfg.dmg);
          burst(pp.clone().setY(1.4), 0x8e1a1a, 8, 3, 0.5, 0.28);
        }
      }
      // boss slam AOE
      if (e.isBoss){
        e.slamCd -= dt;
        if (e.slamCd<=0 && d<9 && e.slamming<=0){ e.slamming = 0.9; e.slamCd = 6.5; }
        if (e.slamming>0){
          e.slamming -= dt;
          const t = 1 - e.slamming/0.9;
          slamRing.position.set(ep.x, 0.06, ep.z);
          slamRing.scale.setScalar(1 + t*8);
          slamRing.material.opacity = 0.7*(1-t);
          if (e.slamming<=0){
            slamRing.material.opacity = 0;
            G.shake = Math.max(G.shake, 0.9);
            burst(new THREE.Vector3(ep.x,0.4,ep.z), 0x9a8a72, 30, 8, 0.8, 0.5);
            if (pp.distanceTo(ep) < 8.5) hurtPlayer(e.cfg.dmg*1.2);
          }
        }
        hud.bossBar.style.width = Math.max(0, e.hp/e.maxHp*100) + '%';
      }
      // hit flash
      if (e.flash>0){
        e.flash -= dt;
        const on = e.flash>0;
        for (const m of e.flashMats){ m.emissive.setHex(on?0x7a1010:m.userData.baseEmissive); m.emissiveIntensity = on?0.9:1; }
      }
    }
    resolveEntityCollisions();

    /* ---- HUD ---- */
    hud.hp.style.width = (G.hp/G.maxHp*100)+'%';
    hud.ammo.innerHTML = G.ammo + ' <small>/ ' + G.mag + '</small>';
    hud.lvl.textContent = 'LEVEL ' + G.level;
    hud.wave.textContent = 'WAVE ' + G.wave + ' / ' + G.WAVES_PER_LEVEL;
    hud.foe.textContent = 'HOSTILES: ' + (G.enemies.length + pendingSpawns.length);
    hud.score.textContent = G.score;
    hud.kills.textContent = G.kills;
  }

  renderer.render(scene, camera);
}

/* ============================================================
   START / RESTART
   ============================================================ */
function resetGame(){
  // clear enemies
  for (const e of [...G.enemies]){ scene.remove(e.group); }
  G.enemies.length = 0; G.boss = null;
  // clear ragdolls
  for (const rd of ragdollPool){
    for (const m of rd){ scene.remove(m); m.geometry.dispose(); m.material.dispose(); }
  }
  ragdollPool.length = 0;
  // reset game state
  Object.assign(G, { running:true, paused:false, over:false, level:1, wave:0, score:0, kills:0,
    cash:0, hp:100, maxHp:100, armor:0, shield:0, shieldHp:0, armorCd:0, shieldCd:0,
    ammo:30, mag:30, reloading:0, fireCd:0, spawnQueue:0, spawnTimer:0, interWave:0, levelClear:0,
    yaw:0, pitch:0.12, shake:0, weapon:'rifle', invOpen:false });
  // reset weapon ownership
  WEAPONS.forEach(w=>{ w.owned = (w.id==='rifle'); });
  pendingSpawns = [];
  player.group.position.set(0,0,150);
  player.group.visible = true;
  player.group.rotation.set(0, Math.PI, 0);
  // remove shield glow
  player.group.traverse(o=>{
    if (o.isMesh && o.material && !o.userData.isGun){
      o.material.emissive.setHex(0);
      o.material.emissiveIntensity = 0;
    }
  });
  // ensure the starting weapon (rifle) is visually equipped
  equipWeapon('rifle');
  hud.bossWrap.style.display = 'none';
  $('menu').style.display = 'none';
  $('gameover').style.display = 'none';
  $('hud').style.display = 'block';
  closeInventory();
  updateHUD();
  G.wave = 1; startWave();
  renderer.domElement.requestPointerLock();
}
function togglePause(){
  if (!G.running) return;
  G.paused = !G.paused;
  $('pauseMenu').style.display = G.paused ? 'flex' : 'none';
  if (G.paused) document.exitPointerLock();
  else renderer.domElement.requestPointerLock();
}
$('startBtn').onclick = resetGame;
$('retryBtn').onclick = resetGame;
$('resumeBtn').onclick = togglePause;
$('invCloseBtn').onclick = closeInventory;
document.addEventListener('pointerlockchange', ()=>{
  if (!document.pointerLockElement && G.running && !G.paused && !G.over) togglePause();
});

// ---------- RESIZE HANDLER ----------
function resizeGame() {
  gameSize = getGameSize();
  camera.aspect = gameSize.width / gameSize.height;
  camera.updateProjectionMatrix();
  renderer.setSize(gameSize.width, gameSize.height, false);
}

// Use ResizeObserver for reliable gameFrame resize detection
const resizeObserver = new ResizeObserver(() => resizeGame());
resizeObserver.observe(gameFrame);

// Also listen for window resize as fallback
addEventListener('resize', resizeGame);

$('loading').style.display = 'none';
window.__game = { spawnEnemy, BOSSES, ZTYPES, G, player };
animate();
</script>
