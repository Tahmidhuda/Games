/* ============================================================
   PARTICLE POOLS & EFFECTS
   ============================================================ */
const MAX_PARTICLES = 600;
const particlePool = [];
const freeParticles = [];
for (let i=0;i<MAX_PARTICLES;i++){
  const s = new THREE.Sprite(new THREE.SpriteMaterial({ map:softTex, transparent:true, opacity:0, depthWrite:false }));
  s.visible = false; scene.add(s);
  particlePool.push(s); freeParticles.push(s);
}
function getParticle(){
  return freeParticles.pop() || particlePool[0];
}
function releaseParticle(p){
  p.visible = false; p.material.opacity = 0;
  freeParticles.push(p);
}

function burst(pos, color, n=14, speed=4, life=0.7, size=0.3){
  for (let i=0;i<n;i++){
    const s = getParticle();
    s.material.color.setHex(color);
    s.material.opacity = 0.95;
    s.scale.setScalar(size*rnd(0.5,1.4));
    s.position.copy(pos);
    s.userData = { vel:new THREE.Vector3(rnd(-1,1),rnd(0.2,1.2),rnd(-1,1)).multiplyScalar(speed*rnd(0.4,1)), life:life*rnd(0.6,1.1), max:life };
    s.visible = true;
  }
}

function muzzleBurst(pos, weapon){
  const colors = { rifle:0xffc36a, shotgun:0xff8a3a, smg:0xffd9a0, uzi:0xffd9a0, assault:0xffe2b0, sniper:0xffebc0 };
  const c = colors[weapon.id] || 0xffc36a;
  const n = weapon.id==='shotgun' ? 8 : (weapon.id==='uzi'||weapon.id==='smg' ? 6 : 4);
  const speed = weapon.id==='shotgun' ? 6 : 4;
  burst(pos, c, n, speed, 0.18, 0.25);
}

function hitBurst(pos, weapon){
  const colors = { rifle:0x7e1a1a, shotgun:0x9e2a2a, smg:0x8e1a1a, sniper:0xae1a1a };
  burst(pos, colors[weapon.id]||0x7e1a1a, weapon.id==='shotgun'?14:8, 3, 0.35, 0.22);
}

/* death ragdoll pools */
const ragdollPool = [];
function createRagdoll(model, isPlayer){
  const parts = [];
  model.group.traverse(o=>{
    if (o.isMesh && o.geometry){
      // clone the mesh with its material
      const m = o.clone();
      m.material = o.material.clone();
      m.position.copy(o.getWorldPosition(new THREE.Vector3()));
      m.quaternion.copy(o.getWorldQuaternion(new THREE.Quaternion()));
      m.scale.copy(o.getWorldScale(new THREE.Vector3()));
      m.userData = {
        vel: new THREE.Vector3(rnd(-1,1), rnd(1,3), rnd(-1,1)).multiplyScalar(2),
        angVel: new THREE.Euler(rnd(-4,4), rnd(-4,4), rnd(-4,4)),
        life: isPlayer ? 1.0 : rnd(0.8,1.4),
        maxLife: isPlayer ? 1.0 : rnd(0.8,1.4),
        isPlayer
      };
      scene.add(m);
      parts.push(m);
    }
  });
  return parts;
}

function updateRagdolls(dt){
  for (let i=ragdollPool.length-1;i>=0;i--){
    const rd = ragdollPool[i];
    let allDead = true;
    for (const m of rd){
      if (m.userData.life > 0){
        allDead = false;
        m.userData.life -= dt;
        m.position.addScaledVector(m.userData.vel, dt);
        m.userData.vel.y -= 9.8 * dt; // gravity
        m.rotation.x += m.userData.angVel.x * dt;
        m.rotation.y += m.userData.angVel.y * dt;
        m.rotation.z += m.userData.angVel.z * dt;
        const t = m.userData.life / m.userData.maxLife;
        m.material.opacity = Math.max(0, t);
        m.material.transparent = true;
        m.material.depthWrite = false;
      }
    }
    if (allDead){
      for (const m of rd){ scene.remove(m); m.geometry.dispose(); m.material.dispose(); }
      ragdollPool.splice(i,1);
    }
  }
}
// tracers
const tracers = [];
function tracer(from, to){
  const geo = new THREE.BufferGeometry().setFromPoints([from, to]);
  const line = new THREE.Line(geo, new THREE.LineBasicMaterial({ color:0xffe0a0, transparent:true, opacity:0.9 }));
  line.userData.life = 0.07;
  scene.add(line); tracers.push(line);
}

