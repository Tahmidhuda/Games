<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Zombie Runner</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html,body { width:100vw; height:100vh; overflow:hidden; background:#050508; font-family:'Segoe UI', Arial, sans-serif; display:flex; align-items:center; justify-content:center; }

  /* ---------- FIXED ASPECT RATIO GAME FRAME ---------- */
  #gameFrame {
    position:relative;
    width: 100vw;
    height: 100vh;
    max-width: calc(100vh * 16 / 9);
    max-height: calc(100vw * 9 / 16);
    aspect-ratio: 16 / 9;
    background:#0b0d10;
    border:3px solid #2a2a35;
    border-radius:4px;
    box-shadow:0 0 40px rgba(0,0,0,.8), inset 0 0 60px rgba(0,0,0,.3);
    overflow:hidden;
  }

  #game { position:absolute; inset:0; width:100%; height:100%; }
  canvas { display:block; width:100% !important; height:100% !important; }

  /* ---------- HUD ---------- */
  #hud { position:absolute; inset:0; pointer-events:none; display:none; z-index:10; }
  #crosshair { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:22px; height:22px; }
  #crosshair::before, #crosshair::after { content:''; position:absolute; background:rgba(255,255,255,.85); box-shadow:0 0 4px #000; }
  #crosshair::before { left:50%; top:0; width:2px; height:100%; transform:translateX(-50%); }
  #crosshair::after { top:50%; left:0; height:2px; width:100%; transform:translateY(-50%); }
  #crosshair .dot { position:absolute; left:50%; top:50%; width:4px; height:4px; background:#ff5544; border-radius:50%; transform:translate(-50%,-50%); }

  #bottomLeft { position:absolute; left:24px; bottom:22px; }
  .barWrap { width:280px; height:20px; background:rgba(0,0,0,.55); border:1px solid rgba(255,255,255,.25); border-radius:4px; overflow:hidden; margin-top:6px; }
  #hpBar { height:100%; width:100%; background:linear-gradient(90deg,#b81f1f,#e84c3d); transition:width .15s; }
  #hpText { color:#fff; font-size:13px; text-shadow:0 1px 2px #000; letter-spacing:1px; }

  #bottomRight { position:absolute; right:24px; bottom:22px; text-align:right; color:#fff; }
  #ammo { font-size:34px; font-weight:700; text-shadow:0 2px 4px #000; letter-spacing:2px; }
  #ammo small { font-size:16px; color:#aaa; }
  #reloadHint { font-size:12px; color:#ffb347; height:16px; letter-spacing:2px; }

  #topCenter { position:absolute; top:16px; left:50%; transform:translateX(-50%); text-align:center; color:#fff; }
  #levelText { font-size:15px; letter-spacing:4px; color:#ffb347; text-shadow:0 1px 3px #000; font-weight:700; }
  #waveText { font-size:13px; letter-spacing:2px; color:#ddd; margin-top:2px; text-shadow:0 1px 2px #000; }
  #enemiesText { font-size:12px; color:#9fbf9f; margin-top:2px; letter-spacing:1px; }

  #bossBarWrap { position:absolute; top:64px; left:50%; transform:translateX(-50%); width:460px; display:none; text-align:center; }
  #bossName { color:#ff6b5e; font-size:14px; letter-spacing:3px; font-weight:700; text-shadow:0 0 8px #a00; margin-bottom:4px; }
  #bossBarOuter { height:14px; background:rgba(0,0,0,.6); border:1px solid #ff6b5e; border-radius:3px; overflow:hidden; }
  #bossBar { height:100%; width:100%; background:linear-gradient(90deg,#7a0d0d,#ff3b2f); transition:width .12s; }

  #scoreBox { position:absolute; top:16px; right:24px; color:#fff; text-align:right; text-shadow:0 1px 3px #000; }
  #scoreBox .k { font-size:11px; color:#9aa; letter-spacing:2px; }
  #scoreBox .v { font-size:20px; font-weight:700; color:#ffd97a; }

  #banner { position:absolute; top:32%; left:50%; transform:translate(-50%,-50%); font-size:44px; font-weight:800; letter-spacing:8px; color:#ffb347; text-shadow:0 0 24px rgba(255,120,0,.6), 0 2px 4px #000; opacity:0; transition:opacity .4s; text-align:center; }
  #banner .sub { font-size:16px; letter-spacing:4px; color:#fff; margin-top:8px; }

  #vignette { position:absolute; inset:0; pointer-events:none; z-index:9; box-shadow:inset 0 0 180px rgba(0,0,0,.85); }
  #dmgFlash { position:absolute; inset:0; pointer-events:none; z-index:11; background:radial-gradient(ellipse at center, transparent 40%, rgba(200,0,0,.55) 100%); opacity:0; transition:opacity .1s; }

  /* ---------- Menus ---------- */
  .overlay { position:absolute; inset:0; z-index:20; display:flex; flex-direction:column; align-items:center; justify-content:center; background:radial-gradient(ellipse at center, rgba(20,16,12,.88), rgba(5,5,7,.97)); color:#fff; text-align:center; }
  .overlay h1 { font-size:56px; letter-spacing:12px; color:#ffb347; text-shadow:0 0 30px rgba(255,110,0,.5); margin-bottom:6px; }
  .overlay h2 { font-size:15px; letter-spacing:6px; color:#c96; font-weight:400; margin-bottom:34px; }
  .overlay .controls { font-size:14px; line-height:2; color:#bbb; letter-spacing:1px; margin-bottom:30px; }
  .overlay .controls b { color:#fff; background:rgba(255,255,255,.12); padding:1px 8px; border-radius:4px; border:1px solid rgba(255,255,255,.2); font-size:12px; }
  .btn { pointer-events:auto; cursor:pointer; font-size:18px; letter-spacing:5px; font-weight:700; color:#111; background:linear-gradient(180deg,#ffc966,#e08b2d); border:none; padding:14px 54px; border-radius:6px; box-shadow:0 0 24px rgba(255,150,40,.35); transition:transform .1s; }
  .btn:hover { transform:scale(1.05); }
  #gameover { display:none; }
  #gameover h1 { color:#ff5544; text-shadow:0 0 30px rgba(255,0,0,.5); }
  #finalStats { font-size:16px; color:#ccc; letter-spacing:2px; line-height:2; margin-bottom:28px; }
  #finalStats span { color:#ffd97a; font-weight:700; }
  #loading { position:absolute; inset:0; z-index:30; display:flex; align-items:center; justify-content:center; background:#0b0d10; color:#ffb347; letter-spacing:6px; font-size:14px; }

/* ---- Inventory grid ---- */
.invItem { background:rgba(255,255,255,.04); border:1px solid rgba(255,150,40,.12); border-radius:6px; padding:14px; text-align:center; transition:transform .1s, box-shadow .1s; }
.invItem:hover { transform:translateY(-2px); box-shadow:0 6px 24px rgba(255,150,40,.15); }
.invItem.owned { border-color:rgba(140,255,140,.35); }
.invItem.equipped { border-color:#ffb347; box-shadow:0 0 16px rgba(255,150,40,.25); }
.invItemName { font-size:13px; letter-spacing:2px; color:#ffb347; font-weight:700; margin-bottom:4px; }
.invItemDesc { font-size:10px; color:#9aa; line-height:1.4; margin-bottom:8px; }
.invItemStats { font-size:10px; color:#ccc; letter-spacing:1px; margin-bottom:10px; }
.invItemPrice { font-size:12px; color:#8fff8f; font-weight:700; margin-bottom:8px; }
.invBtn { width:100%; padding:8px 0; font-size:11px; letter-spacing:2px; border-radius:4px; background:linear-gradient(180deg,#ffc966,#e08b2d); border:none; color:#111; font-weight:700; cursor:pointer; transition:transform .08s; }
.invBtn:disabled { opacity:0.4; cursor:not-allowed; }
.invBtn:hover:not(:disabled) { transform:scale(1.03); }
.invBtn.alt { background:linear-gradient(180deg,#7ac9ff,#4a90d9); }
.defenseGrid { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:16px; }
@media (max-width:560px){ .defenseGrid { grid-template-columns:1fr; } }
.purchaseFlash { animation:pf 0.6s ease-out; }
@keyframes pf { 0%{ box-shadow:0 0 0 0 rgba(140,255,140,.9), 0 0 18px rgba(140,255,140,.5);} 100%{ box-shadow:0 0 0 0 rgba(140,255,140,0), 0 0 0 rgba(140,255,140,0);} }
</style>
</head>
<body>
<div id="gameFrame">
  <div id="game"></div>
  <div id="vignette"></div>
  <div id="dmgFlash"></div>
  <div id="toast" style="position:absolute; left:50%; bottom:120px; transform:translateX(-50%); z-index:12; color:#c8ffc8; background:rgba(8,16,10,.92); border:1px solid rgba(140,255,140,.45); padding:10px 20px; border-radius:6px; font-size:13px; letter-spacing:2px; font-weight:700; opacity:0; transition:opacity .25s; pointer-events:none; box-shadow:0 0 24px rgba(80,255,140,.25);"></div>

  <div id="hud">
  <div id="crosshair"><div class="dot"></div></div>
  <div id="topCenter">
    <div id="levelText">LEVEL 1</div>
    <div id="waveText">WAVE 1 / 5</div>
    <div id="enemiesText">HOSTILES: 0</div>
  </div>
  <div id="bossBarWrap">
    <div id="bossName">STITCHED JUGGERNAUT</div>
    <div id="bossBarOuter"><div id="bossBar"></div></div>
  </div>
  <div id="bottomLeft">
    <div id="hpText">INTEGRITY</div>
    <div class="barWrap" style="position:relative;">
      <div id="shieldBar" style="position:absolute; left:0; top:0; height:100%; background:linear-gradient(90deg,rgba(0,180,255,.4),rgba(0,100,255,.6)); opacity:0; transition:opacity .2s; border-radius:4px;"></div>
      <div id="armorBar" style="position:absolute; left:0; top:0; height:100%; background:linear-gradient(90deg,rgba(255,200,0,.3),rgba(255,160,0,.5)); opacity:0; transition:opacity .2s; border-radius:4px;"></div>
      <div id="hpBar" style="position:relative; z-index:2;"></div>
    </div>
    <div style="display:flex; gap:16px; margin-top:4px; font-size:11px; align-items:center; flex-wrap:wrap;">
      <span id="armorIcon" style="color:#ffc800; display:flex; align-items:center; gap:6px;">⛨ ARMOR <b id="armorCount">x0</b> <span id="armorCooldown" style="color:#888; font-size:10px;"></span></span>
      <span id="shieldIcon" style="color:#00b4ff; display:flex; align-items:center; gap:6px;">◈ SHIELD <b id="shieldPct">0%</b> <span id="shieldCooldown" style="color:#888; font-size:10px;"></span></b></span>
    </div>
  </div>
  <div id="bottomRight">
    <div id="reloadHint"></div>
    <div id="ammo">30 <small>/ 30</small></div>
  </div>
  <div id="scoreBox">
    <div class="k">SCORE</div><div class="v" id="scoreVal">0</div>
    <div class="k" style="margin-top:6px">KILLS</div><div class="v" id="killVal" style="color:#ff8f7a">0</div>
    <div class="k" style="margin-top:6px">CASH</div><div class="v" id="cashVal" style="color:#8fff8f">0</div>
  </div>
  <div id="banner"></div>
</div>

<div id="menu" class="overlay">
  <h1>ZOMBIE RUNNER</h1>
  <h2>THIRD-PERSON ZOMBIE ROAD SURVIVAL</h2>
  <div class="controls">
    <b>W A S D</b> move &nbsp; <b>MOUSE</b> aim &nbsp; <b>LMB</b> fire &nbsp; <b>R</b> reload<br/>
    <b>SHIFT</b> sprint &nbsp; <b>P</b> pause<br/><br/>
    Clear 5 waves to finish a level — a <span style="color:#ff6b5e">COLOSSUS</span> waits at the end of every level.
  </div>
  <button class="btn" id="startBtn">DEPLOY</button>
</div>

<div id="gameover" class="overlay">
  <h1>K.I.A.</h1>
  <h2>THE MILE CLAIMS ANOTHER</h2>
  <div id="finalStats"></div>
  <button class="btn" id="retryBtn">REDEPLOY</button>
</div>

<div id="pauseMenu" class="overlay" style="display:none">
  <h1 style="font-size:40px">PAUSED</h1>
  <h2>CLICK TO RESUME</h2>
  <button class="btn" id="resumeBtn">RESUME</button>
</div>

<div id="invMenu" class="overlay" style="display:none; opacity:0; transition:opacity 0.22s;">
  <div style="width:90%; max-width:820px; background:rgba(10,10,14,.92); border:1px solid rgba(255,150,40,.2); border-radius:8px; padding:24px; box-shadow:0 0 48px rgba(0,0,0,.7);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; border-bottom:1px solid rgba(255,150,40,.15); padding-bottom:12px;">
      <h1 style="font-size:28px; letter-spacing:6px; color:#ffb347; margin:0;">ARMORY</h1>
      <div style="display:flex; gap:16px; align-items:center; font-size:14px; color:#bbb;">
        <span>CASH: <b id="invCash" style="color:#8fff8f">0</b></span>
        <span id="invEquipped" style="color:#ffd97a;">EQUIPPED: ASSAULT RIFLE</span>
      </div>
    </div>
    <div id="invGrid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:16px;"></div>
    <div style="margin-top:18px; text-align:center;">
      <button class="btn" id="invCloseBtn" style="padding:10px 40px; font-size:14px;">CLOSE (TAB)</button>
    </div>
  </div>
</div>

<div id="loading">ESTABLISHING PERIMETER…</div>
</div><!-- /gameFrame -->

<script type="importmap">
{ "imports": { "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js" } }
</script>

<script type="module">
import * as THREE from 'three';

/* ============================================================
   DEAD MILE — third-person zombie road survival
   ============================================================ */

// ---------- renderer / scene ----------
const gameFrame = document.getElementById('gameFrame');

function getGameSize() {
  const rect = gameFrame.getBoundingClientRect();
  return { width: rect.width, height: rect.height };
}

let gameSize = getGameSize();

const renderer = new THREE.WebGLRenderer({ antialias:true, powerPreference:'high-performance' });
renderer.setSize(gameSize.width, gameSize.height);
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.35;
document.getElementById('game').appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x2b2e35);
scene.fog = new THREE.FogExp2(0x2b2e35, 0.0105);

const camera = new THREE.PerspectiveCamera(62, gameSize.width / gameSize.height, 0.1, 600);

// ---------- lighting ----------
const hemi = new THREE.HemisphereLight(0x5a6478, 0x2a201a, 1.0);
scene.add(hemi);

const duskSun = new THREE.DirectionalLight(0xff9a55, 2.4);          // low stormy dusk sun
duskSun.position.set(70, 46, -95);
duskSun.castShadow = true;
duskSun.shadow.mapSize.set(2048, 2048);
duskSun.shadow.camera.left = -90; duskSun.shadow.camera.right = 90;
duskSun.shadow.camera.top = 90;   duskSun.shadow.camera.bottom = -90;
duskSun.shadow.camera.near = 10;  duskSun.shadow.camera.far = 320;
duskSun.shadow.bias = -0.0006;
scene.add(duskSun);
scene.add(duskSun.target);

const rim = new THREE.DirectionalLight(0x5a6f95, 0.7);              // cold fill from opposite side
rim.position.set(-50, 60, 70);
scene.add(rim);

// soft light that follows the player so the hero stays readable in the gloom
const heroLight = new THREE.PointLight(0xffd9b0, 9, 14, 1.6);
scene.add(heroLight);

// ---------- canvas texture helpers ----------
function canvasTex(w, h, draw, repeat) {
  const c = document.createElement('canvas'); c.width = w; c.height = h;
  draw(c.getContext('2d'), w, h);
  const t = new THREE.CanvasTexture(c);
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  if (repeat) t.repeat.set(repeat[0], repeat[1]);
  t.anisotropy = 4;
  return t;
}
const rnd = (a,b)=>a+Math.random()*(b-a);

// cracked asphalt road with lane markings (matches the aerial reference)
const roadTex = canvasTex(512, 1024, (g,w,h)=>{
  g.fillStyle = '#33343a'; g.fillRect(0,0,w,h);
  // asphalt noise
  for (let i=0;i<9000;i++){
    const v = rnd(0,40)|0;
    g.fillStyle = `rgba(${40+v},${40+v},${44+v},${rnd(0.15,0.5)})`;
    g.fillRect(rnd(0,w), rnd(0,h), rnd(1,3), rnd(1,3));
  }
  // dark patches / oil stains
  for (let i=0;i<26;i++){
    g.fillStyle = `rgba(10,10,12,${rnd(0.1,0.3)})`;
    g.beginPath(); g.ellipse(rnd(0,w), rnd(0,h), rnd(20,90), rnd(15,60), rnd(0,3), 0, 7); g.fill();
  }
  // cracks — jagged dark polylines
  g.strokeStyle = 'rgba(12,12,14,0.85)'; g.lineWidth = 2;
  for (let i=0;i<46;i++){
    let x = rnd(0,w), y = rnd(0,h);
    g.beginPath(); g.moveTo(x,y);
    const segs = rnd(4,9)|0;
    for (let s=0;s<segs;s++){ x += rnd(-46,46); y += rnd(-46,46); g.lineTo(x,y); }
    g.stroke();
  }
  // grass tufts in cracks
  for (let i=0;i<120;i++){
    g.strokeStyle = `rgba(${60+rnd(0,30)|0},${75+rnd(0,30)|0},30,${rnd(0.4,0.9)})`;
    g.lineWidth = 1.4;
    const x = rnd(0,w), y = rnd(0,h);
    for (let b=0;b<4;b++){ g.beginPath(); g.moveTo(x,y); g.lineTo(x+rnd(-6,6), y-rnd(4,12)); g.stroke(); }
  }
  // center double yellow line (worn)
  g.fillStyle = 'rgba(190,150,40,0.55)';
  g.fillRect(w/2-14,1,5,h); g.fillRect(w/2+9,0,5,h);
  // worn white edge dashes
  g.fillStyle = 'rgba(200,200,200,0.35)';
  for (let y=0;y<h;y+=64){ g.fillRect(18,y,6,34); g.fillRect(w-24,y,6,34); }
}, [1, 14]);

// building facade with broken/lit windows
function facadeTex(base){
  return canvasTex(256, 512, (g,w,h)=>{
    g.fillStyle = base; g.fillRect(0,0,w,h);
    for (let i=0;i<2600;i++){
      const v = rnd(-14,14)|0;
      g.fillStyle = `rgba(${90+v},${80+v},${70+v},0.12)`;
      g.fillRect(rnd(0,w), rnd(0,h), rnd(1,4), rnd(1,4));
    }
    const cols = 5, rows = 9;
    for (let r=0;r<rows;r++) for (let c=0;c<cols;c++){
      const x = 14 + c*(w-28)/cols, y = 16 + r*(h-30)/rows, ww = (w-28)/cols-12, hh = (h-30)/rows-14;
      const lit = Math.random() < 0.07;
      g.fillStyle = lit ? 'rgba(255,190,90,0.85)' : `rgba(${8+rnd(0,18)|0},${10+rnd(0,16)|0},${14+rnd(0,14)|0},0.95)`;
      g.fillRect(x,y,ww,hh);
      if (Math.random()<0.3){ // boarded / broken
        g.strokeStyle = 'rgba(60,45,30,0.9)'; g.lineWidth = 3;
        g.beginPath(); g.moveTo(x,y+hh); g.lineTo(x+ww,y); g.stroke();
      }
      g.strokeStyle = 'rgba(0,0,0,0.5)'; g.lineWidth = 2; g.strokeRect(x,y,ww,hh);
    }
    // grime streaks
    for (let i=0;i<22;i++){
      g.fillStyle = `rgba(15,12,10,${rnd(0.08,0.25)})`;
      const x = rnd(0,w); g.fillRect(x, rnd(0,h*0.4), rnd(3,10), rnd(40,180));
    }
  });
}

// soft round sprite (smoke / glow / blood puff)
const softTex = canvasTex(128,128,(g,w,h)=>{
  const gr = g.createRadialGradient(64,64,4,64,64,62);
  gr.addColorStop(0,'rgba(255,255,255,1)');
  gr.addColorStop(0.5,'rgba(255,255,255,0.45)');
  gr.addColorStop(1,'rgba(255,255,255,0)');
  g.fillStyle = gr; g.fillRect(0,0,w,h);
});

/* ============================================================
   OBB COLLISION SYSTEM
   Ground objects (cars, trucks, barriers, sandbags, buildings,
   rubble, sidewalk edges) register as axis-aligned-in-local
   boxes (OBB). Player + enemies are circles; a circle-vs-OBB
   push-out keeps them from sliding through. resolveEntityCollisions
   stops living things from piling into each other.
   ============================================================ */
const PLAYER_RADIUS = 0.62;            // player collision circle
const colliders = [];                  // { x,z,hw,hd,yaw } world-space OBBs
function registerBox(x, z, hw, hd, yaw=0){
  if (hw < 0.28 || hd < 0.28) return;  // no collisions from dust-sized rubble
  colliders.push({ x, z, hw:Math.abs(hw), hd:Math.abs(hd), yaw });
}
// register a box that sits at a rotated offset from a parent group
function regOffset(px, pz, yaw, lx, lz, hw, hd, extraYaw=0){
  const c = Math.cos(yaw), s = Math.sin(yaw);
  registerBox(px + lx*c + lz*s, pz - lx*s + lz*c, hw, hd, yaw + extraYaw);
}
// closest point on an OBB to a circle center → push vector or null
function circleVsBox(cx, cz, r, b){
  const dx = cx - b.x, dz = cz - b.z;
  const c = Math.cos(b.yaw), s = Math.sin(b.yaw);
  const lx =  dx*c - dz*s;                  // world → box local
  const lz =  dx*s + dz*c;
  const qx = Math.max(-b.hw, Math.min(b.hw, lx));
  const qz = Math.max(-b.hd, Math.min(b.hd, lz));
  let px = lx - qx, pz = lz - qz;
  let d2 = px*px + pz*pz;
  if (d2 === 0){                            // center inside the box → nearest face
    const ox = b.hw - Math.abs(lx), oz = b.hd - Math.abs(lz);
    if (ox < oz){ px = (lx >= 0 ? 1 : -1) * ox; pz = 0; }
    else         { px = 0; pz = (lz >= 0 ? 1 : -1) * oz; }
    d2 = px*px + pz*pz;
  }
  const d = Math.sqrt(d2);
  if (d >= r) return null;
  const push = r - d, inv = 1/d;
  // push back to world space
  return { x:(px*inv*c + pz*inv*s)*push, z:(-px*inv*s + pz*inv*c)*push };
}
function resolveCollisions(group, radius){
  const p = group.position;
  for (const b of colliders){
    // conservative broad-phase: a rotated OBB's world projection never
    // exceeds hw+hd, so use that instead of the raw half-extents
    const ex = b.hw + b.hd + radius;
    if (p.x - b.x >  ex) continue;
    if (b.x - p.x >  ex) continue;
    if (p.z - b.z >  ex) continue;
    if (b.z - p.z >  ex) continue;
    const res = circleVsBox(p.x, p.z, radius, b);
    if (res){ p.x += res.x; p.z += res.z; }
  }
}
// living entities (player + enemies) don't overlap
function resolveEntityCollisions(){
  const pp = player.group.position;
  for (const e of G.enemies){
    const r = PLAYER_RADIUS + e.cfg.radius;
    const dx = e.group.position.x - pp.x, dz = e.group.position.z - pp.z;
    const d2 = dx*dx + dz*dz;
    if (d2 < r*r && d2 > 1e-6){
      const d = Math.sqrt(d2), push = (r - d)/2, nx = dx/d, nz = dz/d;
      e.group.position.x += nx*push; e.group.position.z += nz*push;
      pp.x -= nx*push; pp.z -= nz*push;
    }
  }
  const es = G.enemies;
  for (let i=0;i<es.length;i++) for (let j=i+1;j<es.length;j++){
    const a = es[i], b = es[j];
    const rr = a.cfg.radius + b.cfg.radius;
    const dx = b.group.position.x - a.group.position.x, dz = b.group.position.z - a.group.position.z;
    const d2 = dx*dx + dz*dz;
    if (d2 < rr*rr && d2 > 1e-6){
      const d = Math.sqrt(d2), push = (rr - d)/2, nx = dx/d, nz = dz/d;
      a.group.position.x -= nx*push; a.group.position.z -= nz*push;
      b.group.position.x += nx*push; b.group.position.z += nz*push;
    }
  }
}

