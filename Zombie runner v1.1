  for (let i=0;i<6;i++){ const t = cone(0.05,0.24, bone, -0.28+i*0.11, -0.2, 0.55); t.rotation.x = Math.PI; parts.head.add(t); }
  // brow horns
  parts.head.add(cone(0.09,0.5, bone, -0.35,0.2,0.05)); parts.head.add(cone(0.09,0.5, bone, 0.35,0.2,0.05));
