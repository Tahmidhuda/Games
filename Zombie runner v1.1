function buildJuggernaut(){          // Stitched Juggernaut — grey-green stitched giant, bone claw
  const g = new THREE.Group();
  const flesh = M(0x7a8272,{roughness:1}), dark = M(0x3c3a35), bone = M(0xcfc4a8);
  const parts = {};
  parts.body = box(1.7,1.7,1.0, flesh, 0,2.2,0); g.add(parts.body);
  // stitches — criss-crossing threads with 3D knots
  for (let i=0;i<8;i++){
    const s = box(0.05,0.28,0.04, M(0x2a1a14), -0.45+i*0.14+rnd(-0.03,0.03), 2.2+Math.sin(i)*0.3, 0.52);
    s.rotation.z = rnd(-0.5,0.5); g.add(s);
    const knot = sph(0.035, M(0x2a1a14), s.position.x, s.position.y-0.1, 0.55, 5,4); knot.scale.z = 0.6; g.add(knot);
  }
  // thick torso stitching seam down the middle
  for (let i=-2;i<=2;i++){
    const seam = box(0.03,0.2,0.02, M(0x2a1a14), 0.16+i*0.02, 2.1+i*0.22, 0.5);
    seam.rotation.z = 0.35; g.add(seam);
  }
  // rusted skin-graft plates bolted into the flesh
  const plateM = M(0x4a443c,{metalness:0.6,roughness:0.5});
  g.add(box(0.6,0.5,0.12, plateM, -0.55,2.7,0.5));
  g.add(box(0.5,0.44,0.12, plateM, 0.6,1.9,0.5));
  // bolts on the plates
  for (let i=-1;i<=1;i++) g.add(sph(0.045, M(0x141414,{metalness:0.8,roughness:0.3}), -0.55+i*0.25, 2.72, 0.58));
  for (let i=-1;i<=1;i++) g.add(sph(0.045, M(0x141414,{metalness:0.8,roughness:0.3}), 0.6+i*0.2, 1.9, 0.58));
  // heavy chain links
  for (let i=0;i<6;i++){
    const link = new THREE.Mesh(new THREE.TorusGeometry(0.11,0.035,6,10), M(0x3a3a3a,{metalness:0.7,roughness:0.4}));
    link.position.set(-0.8+i*0.32, 2.95 - Math.sin(i/5*Math.PI)*0.25, 0.4);
    link.rotation.y = i%2?Math.PI/2:0; link.castShadow = true; g.add(link);
  }
  parts.head = new THREE.Group(); parts.head.position.set(0,3.35,0.15);
  parts.head.add(sph(0.34, flesh, 0,0,0));
  const eyeM = M(0x000000,{emissive:0xf3e9c8, emissiveIntensity:2});
  parts.head.add(sph(0.05, eyeM, -0.12,0.05,0.3,6,5));
  parts.head.add(sph(0.05, eyeM,  0.12,0.05,0.3,6,5));
  parts.head.add(box(0.24,0.1,0.08, M(0x301616), 0,-0.14,0.3));
  const hair = sph(0.35, M(0x2c2620), 0,0.12,-0.08); hair.scale.set(1,0.6,1); parts.head.add(hair);
  g.add(parts.head);

  function arm(side, claw){
    const a = new THREE.Group(); a.position.set(side*1.05, 2.9, 0);
    a.add(box(0.5,0.9,0.5, flesh, 0,-0.4,0));
    a.add(box(0.44,0.9,0.44, flesh, 0,-1.2,0.05));
    if (claw){ // bone-cluster claw hand
      for (let i=0;i<5;i++){
        const c = cone(0.09, rnd(0.5,0.8), bone, rnd(-0.2,0.2), -1.85, rnd(-0.1,0.25));
        c.rotation.x = Math.PI + rnd(-0.4,0.4); a.add(c);
      }
      a.add(sph(0.3, M(0x8a4a42), 0,-1.7,0.05));
      // bone spikes along the outside of the claw arm
      for (let i=0;i<3;i++){
        const sp = cone(0.06, rnd(0.25,0.4), bone, side*0.28, -0.2-i*0.35, 0.1);
        sp.rotation.x = Math.PI+0.6; sp.rotation.y = -side*0.5; a.add(sp);
      }
    } else {
      a.add(sph(0.28, flesh, 0,-1.75,0.05));
      // armored knuckle plate
      a.add(box(0.5,0.16,0.3, plateM, 0,-1.85,0.18));
    }
    return a;
  }
  parts.lArm = arm(-1,false); parts.rArm = arm(1,true);
  g.add(parts.lArm, parts.rArm);

  function leg(side){
    const l = new THREE.Group(); l.position.set(side*0.5, 1.4, 0);
    l.add(box(0.55,0.8,0.55, flesh, 0,-0.35,0));
    l.add(box(0.48,0.7,0.48, dark, 0,-1.0,0));
    l.add(box(0.55,0.25,0.75, M(0x33302a), 0,-1.4,0.08));
    // stitching up the outer thigh
    for (let i=0;i<3;i++){
      const st = box(0.03,0.14,0.03, M(0x2a1a14), side*0.2, -0.15-i*0.22, 0.28); st.rotation.z = side*0.4; l.add(st);
    }
    return l;
  }
  parts.lLeg = leg(-1); parts.rLeg = leg(1);
  g.add(parts.lLeg, parts.rLeg);
  return { group:g, parts };
}

