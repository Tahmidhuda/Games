/* ============================================================
   WEAPON DEFINITIONS & LOADOUT
   ============================================================ */
const WEAPONS = [
  { id:'rifle', name:'PISTOL', dmg:25, rpm:200, mag:20, spread:0.02, range:60, cost:0, owned:true, desc:'Standard issue. Reliable.' },
  { id:'shotgun', name:'SHOTGUN', dmg:20, pellets:8, rpm:300, mag:8, spread:0.18, range:18, cost:800, owned:false, desc:'Devastating close. 8 pellet spread.' },
  { id:'uzi', name:'DUAL UZI', dmg:15, rpm:400, mag:60, spread:0.05, range:100, cost:1200, owned:false, dual:true, desc:'Dual-wield SMGs. High volume.' },
  { id:'assault', name:'ASSAULT RIFLE', dmg:50, rpm:300, mag:100, spread:0.015, range:180, cost:2000, owned:false, desc:'Military grade. Superior damage.' },
];

/* ============================================================
   WEAPON VISUAL SYSTEM — creates distinct models per weapon
   ============================================================ */
function createWeaponModel(weaponId) {
  const w = WEAPONS.find(x => x.id === weaponId);
  if (!w) return null;
  const gun = new THREE.Group();
  const gm = new THREE.MeshStandardMaterial({ color:0x1c1d20, roughness:0.5, metalness:0.6 });
  const mgMat = new THREE.MeshStandardMaterial({ color:0x2a2a2a, roughness:0.6, metalness:0.4 });
  const sightMat = new THREE.MeshStandardMaterial({ color:0x0f1012, roughness:0.3, metalness:0.7 });
  const muzzle = new THREE.Object3D();

  if (weaponId === 'rifle') {
    // Pistol — compact handgun
    gun.add(new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.12, 0.28), gm)); // slide/barrel
    const grip = new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.1, 0.12), gm); // grip
    grip.position.set(0, -0.08, -0.06); gun.add(grip);
    gun.add(new THREE.Mesh(new THREE.BoxGeometry(0.02, 0.03, 0.06), sightMat)); // front sight
    muzzle.position.set(0, 0, 0.22);
  } else if (weaponId === 'shotgun') {
    // Pump-action shotgun — shorter, thicker barrel, pump foregrip, no stock or folding stock
    gun.add(new THREE.Mesh(new THREE.BoxGeometry(0.09, 0.11, 0.55), gm)); // thick barrel
    gun.add(new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.15, 0.18), gm)); // receiver
    gun.add(new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.12, 0.15), gm)); // pump foregrip
    gun.add(new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.05, 0.18), gm)); // folding stock (folded)
    gun.add(new THREE.Mesh(new THREE.BoxGeometry(0.02, 0.04, 0.08), sightMat)); // bead sight
    muzzle.position.set(0, 0, 0.42);
  } else if (weaponId === 'uzi') {
    // Dual UZI — two compact SMGs, one per hand
    const uziMat = new THREE.MeshStandardMaterial({ color:0x2a2a2a, roughness:0.55, metalness:0.65 });
    function buildUzi() {
      const g = new THREE.Group();
      g.add(new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.09, 0.35), uziMat));       // barrel/receiver
      const grip = new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.12, 0.12), uziMat);  // grip+mag
      grip.position.set(0, -0.08, -0.06); g.add(grip);
      const stock = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.04, 0.1), uziMat);  // folded stock
      stock.position.set(0, 0.06, -0.1); g.add(stock);
      const mz = new THREE.Object3D(); mz.position.set(0, 0, 0.28); g.add(mz);
      return { group: g, muzzle: mz };
    }
    const L = buildUzi();
    const R = buildUzi();
    L.group.position.set(0, -0.66, 0.1);
    R.group.position.set(0, -0.66, 0.1);
    // mark meshes as gun parts
    L.group.traverse(o => { if (o.isMesh) o.userData.isGun = true; });
    R.group.traverse(o => { if (o.isMesh) o.userData.isGun = true; });
    return { left: L.group, right: R.group, muzzleL: L.muzzle, muzzleR: R.muzzle, isDual: true };
  } else if (weaponId === 'assault') {
    // Assault rifle — military style, longer barrel, full stock, optic rail
    gun.add(new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.1, 0.8), gm));
    gun.add(new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.15, 0.18), gm));
    gun.add(new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.06, 0.25), gm)); // full stock
    gun.add(new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.03, 0.25), sightMat)); // optic rail
    gun.add(new THREE.Mesh(new THREE.BoxGeometry(0.02, 0.05, 0.1), sightMat)); // front sight
    muzzle.position.set(0, 0, 0.55);
  }

  gun.add(muzzle);
  // hold at the right-hand glove position (same anchor as the original rifle)
  gun.position.set(0, -0.66, 0.1);
  // mark meshes as gun parts so shield glow doesn't affect them
  gun.traverse(o => { if (o.isMesh) o.userData.isGun = true; });
  return { group: gun, muzzle, isDual: false };
}

